{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=tenantly;Username=postgres;Password=password"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Database=tenantly;Username=postgres;Password=password",
    "CommandTimeout": 30,
    "MaxRetryAttempts": 3
  },
  "Notifications": {
    "ProcessingIntervalSeconds": 30,
    "MaxRetryAttempts": 5,
    "Sms": {
      "Provider": "ssl_wireless",
      "ApiKey": "",
      "ApiUrl": "https://smsplus.sslwireless.com/api/v3/send-sms",
      "SenderId": "TENANTLY"
    },
    "Email": {
      "SmtpHost": "smtp.gmail.com",
      "SmtpPort": 587,
      "Username": "",
      "Password": "",
      "FromEmail": "noreply@tenantly.com",
      "FromName": "Tenantly",
      "EnableSsl": true
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tenantly-notification-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}