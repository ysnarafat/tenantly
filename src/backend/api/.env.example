# =============================================================================
# TENANTLY API ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables needed for the Tenantly API
# Copy this file to .env and update the values according to your environment
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the API server to listen on
PORT=8080

# Environment (development, staging, production)
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection URL
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=

# Alternative database configuration (if you prefer separate variables)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=tenantly
# DB_SSLMODE=disable

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================
# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!)
# Generate a strong random key: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-use-openssl-rand-base64-32

# JWT token expiration duration (examples: 1h, 8h, 24h, 30m)
JWT_EXPIRATION=8h

# NID (National ID) protection at rest. Required in production.
# NID_ENCRYPTION_KEY: base64-encoded 32-byte AES-256 key (openssl rand -base64 32).
# NID_HASH_PEPPER: secret used to key the deterministic uniqueness hash.
# In development these are derived from stable dev defaults if unset.
NID_ENCRYPTION_KEY=
NID_HASH_PEPPER=

# =============================================================================
# EMAIL CONFIGURATION (for notifications and password reset)
# =============================================================================
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# From email address for outgoing emails
FROM_EMAIL=noreply@tenantly.com

# =============================================================================
# SMS CONFIGURATION (for notifications)
# =============================================================================
# SMS provider (ssl_wireless, twilio, etc.)
SMS_PROVIDER=

# SMS API credentials
SMS_API_KEY=your-sms-api-key
SMS_API_URL=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Trusted proxy IPs/CIDRs (comma-separated) so Gin's ClientIP() (used by rate
# limiting) reads X-Forwarded-For only from these hops and can't be spoofed by
# the client. Leave empty in local dev; set to your load balancer/proxy IPs in production.
TRUSTED_PROXIES=

# Refresh-token cookie settings. COOKIE_DOMAIN scopes the cookie to a specific
# domain (leave empty for host-only). COOKIE_SECURE defaults to true in
# production, false in development; set explicitly to override.
COOKIE_DOMAIN=
COOKIE_SECURE=

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# =============================================================================
# EXTERNAL SERVICES (Optional - for future integrations)
# =============================================================================
# Redis configuration (for caching and session storage)
# REDIS_URL=redis://localhost:6379

# File storage configuration
# STORAGE_TYPE=local
# STORAGE_PATH=./uploads
# MAX_FILE_SIZE=10MB

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable debug mode (shows detailed error messages)
DEBUG=true

# Enable database query logging
DB_LOG_QUERIES=false

# Auto-migrate database on startup
AUTO_MIGRATE=true

# =============================================================================
# PRODUCTION CONFIGURATION NOTES
# =============================================================================
# For production deployment, make sure to:
# 1. Change JWT_SECRET to a strong random value
# 2. Set ENVIRONMENT=production
# 3. Use a secure DATABASE_URL with proper credentials
# 4. Configure proper SMTP settings for email
# 5. Set DEBUG=false
# 6. Use HTTPS and proper SSL certificates
# 7. Configure proper CORS_ALLOWED_ORIGINS
# 8. Set up proper logging and monitoring
# =============================================================================
