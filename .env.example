# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/tenantly?sslmode=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=8h

# Environment
ENVIRONMENT=development
PORT=8080

# SMS Configuration (Bangladesh providers)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@tenantly.com