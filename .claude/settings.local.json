{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run *)",
      "Bash(npm run:*)",
      "Bash(git add *)",
      "Bash(git rebase *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go tool *)",
      "Bash(npx tsc *)",
      "Bash(git commit -m ' *)",
      "Bash(git reset *)",
      "Bash(go mod *)",
      "Bash(go get *)",
      "Bash(GIT_EDITOR=true git rebase *)",
      "Bash(git -c core.editor=true rebase --continue)",
      "Bash(EDITOR=true git rebase --continue)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git stash *)",
      "Bash(git config *)",
      "Bash(xargs -I{} echo {})",
      "Bash(node *)"
    ]
  },
  "enabledMcpjsonServers": [
    "angular-cli"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.argv[1];const f=require('fs');if(f.existsSync(p)){const r=require('child_process').spawnSync(process.execPath,[p],{stdio:'inherit'});process.exit(r.status===null?1:r.status);}\" \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.argv[1];const f=require('fs');if(f.existsSync(p)){const r=require('child_process').spawnSync(process.execPath,[p],{stdio:'inherit'});process.exit(r.status===null?1:r.status);}\" \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write/MultiEdit on UI files, full-rule deep pass on Stop."
}
